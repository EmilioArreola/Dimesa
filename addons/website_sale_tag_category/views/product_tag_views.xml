<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_tag_form_view_inherit_category_filter" model="ir.ui.view">
        <field name="name">product.tag.form.inherit.category.filter</field>
        <field name="model">product.tag</field>
        <field name="inherit_id" ref="product.product_tag_form_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="filter_group_id" placeholder="Ej: Tipo, Color..."/>
                <field name="public_category_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>